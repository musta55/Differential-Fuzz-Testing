<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.fuzztest</groupId>
  <artifactId>differential-first-tester</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!--
    Differential "first tester": fuzz an LLM-refactored method against its original on the
    SAME Jazzer inputs and report where they diverge. The BASE build carries only the engine's
    own dependencies (Jazzer, JUnit 5, gson). Everything a target project needs to
    compile/run lives in that project's <profile> — so `./mvnw -P<project>` compiles only that
    project, and adding a project never touches the base. See README.md.
  -->

  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jazzer.version>0.22.0</jazzer.version>
    <junit.version>5.9.3</junit.version>
    <!--
      Extra JVM flags for the test JVM, appended to <argLine> below. A bare -DargLine=... on the
      command line CANNOT be used for this: surefire's own <argLine> configuration element wins over
      the property, so the flags are silently dropped. This is the supported seam instead — used by
      scripts/run_project.py to pass -Dfuzz.jazzerCoverage=<path> (see JazzerCoverage).
    -->
    <fuzz.jvmArgs></fuzz.jvmArgs>
  </properties>

  <dependencies>
    <!-- gson: GenericDifferential reads the per-project manifest.json at fuzz time -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
      <scope>test</scope>
    </dependency>

    <!-- Jazzer JUnit 5 integration (the fuzzing engine) -->
    <dependency>
      <groupId>com.code-intelligence</groupId>
      <artifactId>jazzer-junit</artifactId>
      <version>${jazzer.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- SLF4J: many refactored snapshots log; keep a binding on the classpath so they load -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.2.12</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- 2.22+ required for JUnit 5 Platform support -->
        <version>2.22.2</version>
        <configuration>
          <!-- Jazzer instruments bytecode at load time. JAZZER_FUZZ=1 activates fuzzing;
               without it, only the corpus seeds replay. -->
          <argLine>-XX:+IgnoreUnrecognizedVMOptions ${fuzz.jvmArgs}</argLine>
          <!-- Sandbox the test JVM cwd: fuzzed args passed to file-I/O create files in cwd;
               keep that litter inside target/ (git-ignored) instead of the module root. -->
          <workingDirectory>${project.build.directory}/fuzz-cwd</workingDirectory>
          <includes>
            <include>fuzz/auto/*FuzzTest.java</include>
          </includes>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <!--
    ONE PROFILE PER TARGET PROJECT. Activate with -P<project> so only that project's
    generated sources compile, with its own dependencies. Every profile below except
    `example` is generated by scripts/project_setup.py — register a project with it rather
    than writing one by hand:  python3 scripts/project_setup.py <name> -d <project checkout>
  -->
  <profiles>
    <profile>
      <!-- Self-contained smoke test (no external deps): the issue-reproduction Simple.java,
           exercising constructor diffs, boxed-type params, and secondary-class relocation. -->
      <id>example</id>
      <build><plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.2.0</version>
          <executions><execution>
            <id>add-example</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration><sources>
              <source>src/test/Dataset/example</source>
              <source>src/test/fuzzing/example</source>
            </sources></configuration>
          </execution></executions>
        </plugin>
      </plugins></build>
    </profile>
    <!-- BEGIN GENERATED PROFILE: deltaspike (scripts/project_setup.py) -->
    <profile>
