# Generated by the pipeline from the input trees — regenerate with run.py, never commit.
/src/test/Dataset/
/src/test/fuzzing/
/src/test/resources/
/reports/

# Build + fuzzing runtime artifacts
target/
.cifuzz-corpus/
*.log
run_*.log

# Working-state / session context — never commit (see handoff.md provenance notes)
/context.md
/handoff.md

# Local Maven / editor
.idea/
*.iml

# Python
__pycache__/
*.pyc

# Java build artifacts (GitHub Java template)
*.class
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# EvoSuite jars, fetched by scripts/setup_evosuite.sh (~27MB, not source)
/tools/

# EvoSuite writes these into its working directory; gen_unittests.py contains them under
# target/evosuite/<project>/ but an interrupted or hand-run invocation can still drop them here.
/evosuite-report/
/evosuite-tests/
/.evosuite/
issues/